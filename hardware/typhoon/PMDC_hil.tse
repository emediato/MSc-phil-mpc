    CODE model_init
        # Numpy module is imported as 'np'
        # Scipy module is imported as 'sp'
        # The Schematic API is imported as 'mdl'
        # To get the model file path, use 'mdl.get_model_file_path()'
        # To print information to the console, use info()
        
        Te = 1e-7  # Simulation time step (can be decreased further, ...)
        pi = np.pi
        
        Um = 230*1.4142  # Grid voltage amplitude (phase voltage)
        f = 50    # Grid voltage frequency
        
        C = 3*470e-6  # DC link capacitors capacitance
        Rc = 33e3  # DC link capacitors voltage balancing resistors
        
        Udc = 600  # DC link nominal voltage (note that it is higher ...)
        La = 3.32e-3     # Armature winding inductance
        Ra = 0.75  # Armature winding resistance
        Ta = La/Ra  # Armature winding time constant (tau)
        
        Ufn = 120   # Field winding nominal voltage
        Ifn = .56  # Field winding nominal current
        Lf = 25   # Field winding inductance
        Rf = Ufn/Ifn     # Field winding resistance
        
        F = 0.7   # Nominal flux - Note that we will use permanent ...
        Laf = F/Ifn      # Mutual inductance
        
        J = 0.02  # Moment of inertia
        Tm = J/F  # Mechanical time constant
        
        Ts = 1/10000     # Switching frequency
    ENDCODE
}
